# Скопируйте в .env и заполните. Файл .env не коммитьте.

# Ключ Anthropic: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Модель Claude. Для голосового ассистента хватает быстрой модели.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=512
CLAUDE_TIMEOUT_SECONDS=30

# Общий секрет приложения и backend. Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Тот же токен впишите в настройках приложения.
APP_TOKEN=

# Разрешённый origin для CORS (нужен только для веб-клиента). Пусто — CORS выключен.
CORS_ORIGIN=

CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_MESSAGES=30
MAX_TEXT_LENGTH=2000
LOG_LEVEL=INFO
